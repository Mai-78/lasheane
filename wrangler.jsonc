// Configuration Cloudflare Workers du site Lashéane.
// À chaque envoi sur GitHub, Cloudflare lance « npx wrangler deploy » :
// le site est d'abord construit (node build.mjs) dans dist/, puis mis en ligne.
{
  "name": "lasheane",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "build": {
    "command": "node build.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Garde les variables et secrets saisis dans le tableau de bord Cloudflare.
  "keep_vars": true,
  // Minimisation des données : pas de journal de chaque visite (invocation_logs),
  // seulement les messages d'erreur techniques, conservés 3 jours par Cloudflare.
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  }
}
